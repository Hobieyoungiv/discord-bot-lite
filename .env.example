# 1. Rename this file to .env  (just ".env", no other name)
# 2. Paste your bot token after the = sign. NEVER share this token or upload it anywhere.
DISCORD_TOKEN=paste-your-token-here

# Optional but recommended: your server's ID. Commands then show up instantly
# instead of taking up to an hour. (Discord: Settings > Advanced > Developer Mode,
# then right-click your server icon > Copy Server ID)
GUILD_ID=
